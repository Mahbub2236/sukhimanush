# ==============================================================================
# Sukhi Manush - Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env on the production server and fill in secrets:
#   cp .env.example .env
#   php artisan key:generate
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment & Core Settings
# ------------------------------------------------------------------------------
APP_NAME="Sukhi Manush"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sukhimanush.com
APP_TIMEZONE=Asia/Dhaka
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Reverse Proxy / Load Balancer IP CIDRs (e.g. 127.0.0.1, 10.0.0.0/8, or * if terminated by trusted Nginx)
TRUSTED_PROXIES="*"

# ------------------------------------------------------------------------------
# Logging & Error Tracking
# ------------------------------------------------------------------------------
# Use 'daily' in production to prevent a single monolithic log file from filling disk space
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# ------------------------------------------------------------------------------
# Database Configuration (MySQL 8.0+ / MariaDB)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sukhimanush_prod
DB_USERNAME=sukhimanush_user
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ------------------------------------------------------------------------------
# Redis In-Memory Store (Cache, Sessions, Queues)
# ------------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ------------------------------------------------------------------------------
# Cache, Session & Queue Drivers
# ------------------------------------------------------------------------------
# For horizontal scaling and fast concurrent access, Redis or database is recommended
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.sukhimanush.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ------------------------------------------------------------------------------
# Sanctum Stateful SPA & API Authentication
# ------------------------------------------------------------------------------
# Comma-separated list of domains that receive stateful cookies
SANCTUM_STATEFUL_DOMAINS="sukhimanush.com,www.sukhimanush.com"
# Token lifetime in minutes (1440 = 24 hours)
SANCTUM_TOKEN_EXPIRATION=1440

# ------------------------------------------------------------------------------
# File Storage & Uploads
# ------------------------------------------------------------------------------
# Private medical reports are stored in storage/app/private
FILESYSTEM_DISK=local

# ------------------------------------------------------------------------------
# Mail Delivery (SMTP / Transactional)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@sukhimanush.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# SMS Notification Gateway (Bangladesh Telco / Aggregator)
# ------------------------------------------------------------------------------
# Supported: 'log' (local/testing), 'custom_http' (e.g. Greenweb, BulkSMSBD, SSLWireless)
SMS_GATEWAY=log
SMS_API_KEY=
SMS_SENDER_ID="SukhiManush"
SMS_USERNAME=
SMS_PASSWORD=
SMS_API_URL=

# ------------------------------------------------------------------------------
# Payment Gateways (bKash, Nagad, SSLCommerz)
# ------------------------------------------------------------------------------
# bKash Merchant Checkout
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_WEBHOOK_SECRET=
BKASH_SANDBOX=false

# Nagad PG Merchant Checkout
NAGAD_MERCHANT_ID=
NAGAD_PG_PUBLIC_KEY=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_WEBHOOK_SECRET=
NAGAD_SANDBOX=false

# SSLCommerz Payment Gateway
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=
SSLCZ_WEBHOOK_SECRET=
SSLCZ_SANDBOX=false

# ------------------------------------------------------------------------------
# AI Inference Services (Health Assistant, Medical Summarization)
# ------------------------------------------------------------------------------
# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq (Ultra-fast LLM Inference)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# Frontend Vite Environment Variables (Built into bundle during npm run build)
# ------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
